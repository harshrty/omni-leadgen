# =============================================================================
# Lead-Gen Pipeline — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# Company identity (name, founder, website, etc.) is configured via the
# Setup tab in the dashboard — you do NOT need to set those here.
# =============================================================================


# --- AI Providers ---
# At minimum, ANTHROPIC_API_KEY is required for email drafting.
# Get a free key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-...

# Optional free providers (enrichment fallback chain):
#   Groq   → https://console.groq.com       (free tier, fast)
#   Gemini → https://aistudio.google.com    (free tier)
#   Cerebras → https://cloud.cerebras.ai   (1M tokens/day, no card)
#   SambaNova → https://cloud.sambanova.ai (unlimited rate-limited)
#   Together  → https://api.together.ai   ($25 free credit)
GROQ_API_KEY=gsk_...
GEMINI_API_KEY=AIza...
CEREBRAS_API_KEY=csk-...
SAMBANOVA_API_KEY=...
TOGETHER_API_KEY=...


# --- Email Sending (Gmail SMTP recommended) ---
# Gmail setup: enable 2FA, then create an App Password at
#   https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@yourdomain.com
SMTP_PASS=xxxx xxxx xxxx xxxx
FROM_EMAIL=you@yourdomain.com
# FROM_NAME defaults to your company name from Setup — override here if needed
# FROM_NAME=Your Name


# --- Email Receiving / Reply Tracking (Gmail IMAP) ---
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=you@yourdomain.com
IMAP_PASS=xxxx xxxx xxxx xxxx


# --- LinkedIn Scraping ---
# Use a dedicated or throwaway LinkedIn account — not your personal one.
LINKEDIN_EMAIL=your-linkedin@email.com
LINKEDIN_PASS=yourpassword


# --- Lead Enrichment: Hunter.io (optional) ---
# Free plan gives 25 credits/month. Add up to 20 keys for rotation.
#   https://hunter.io
HUNTER_API_KEY=...
# HUNTER_API_KEY_2=...
# HUNTER_API_KEY_3=...


# --- Dashboard ---
SERVER_PORT=5000
BASE_URL=http://localhost:5000
